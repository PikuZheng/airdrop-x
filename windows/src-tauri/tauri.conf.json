{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirDrop-X",
  "version": "0.1.0",
  "identifier": "io.airdropx.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AirDrop-X", "width": 680, "height": 700, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}

